# Local development defaults — copy to backend/.env
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

DATABASE_URL=postgresql://vetra_user:vetra_password@localhost:5432/vetra_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vetra_db
DB_USER=vetra_user
DB_PASSWORD=vetra_password
DB_SSL=false

REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

JWT_SECRET=vetra-local-dev-jwt-secret-change-me
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=vetra-local-dev-refresh-secret-change-me
JWT_REFRESH_EXPIRE=30d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet
SOLANA_PROGRAM_ID=
ATTESTATION_PROGRAM_ID=

CORS_ORIGIN=http://localhost:5173,http://localhost:3000,chrome-extension://*
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,chrome-extension://*

# Must match uvicorn port and include /api/analyze
MULTI_AGENT_API_URL=http://localhost:5000/api/analyze
MULTI_AGENT_API_KEY=dev-key

ENABLE_WEBSOCKET=true
ENABLE_ATTESTATIONS=true
ENABLE_REPUTATION_SYSTEM=true
ENABLE_SWAGGER_DOCS=false
ENABLE_SENTRY=false
LOG_LEVEL=info
SESSION_SECRET=vetra-local-session-secret
